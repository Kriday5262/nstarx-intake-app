# Copy to .env and adjust values. Keep .env out of git (it is already ignored).

# PostgreSQL connection used by Drizzle ORM, migrations, and the seed script.
# The host below points to the Kamkazi postgres container exposed on 127.0.0.1.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
DATABASE_NAME=nstarx_intake
DATABASE_USER=nstarx_app
DATABASE_PASSWORD=nstarx_intake_dev

# Admin seed passwords. These are hashed with bcrypt before being stored.
# Pick strong values in any shared environment; they are not echoed or logged.
ADMIN_SHANTANU_PASSWORD=change_me
ADMIN_SUJAY_PASSWORD=change_me

# Optional: force SSL for the connection. Leave unset or false for local dev.
DATABASE_SSL=false

# SendGrid configuration for email notifications.
# Leave SENDGRID_API_KEY empty to disable email and log a warning instead.
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@nstarx-intake.kamkazi.com

# Comma-separated list of admin email addresses that receive new-submission notifications.
ADMIN_NOTIFY_EMAILS=shantanu.chaturvedi@nstarxinc.com,sujay@nstarxinc.com

# Public base URL used for deep links in emails and the optional status page.
NEXT_PUBLIC_BASE_URL=https://nstarx-intake.kamkazi.com
